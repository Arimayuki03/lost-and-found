# ============================================
# 失物招领系统环境变量示例
# 复制为 .env 并填入实际值；真实 .env 含敏感信息，切勿提交到版本库
# ============================================

# 调试开关（run.py 读取；生产环境必须为 0，仅本地开发设 1）
FLASK_DEBUG=0

# 超级管理员初始账号（首次启动自动创建，仅缺失时生效）
SUPER_ADMIN_NAME=your-super-admin-name
SUPER_ADMIN_PASSWORD=your-super-admin-password

# Flask 会话签名密钥（生产环境必须更换为随机长字符串，如 openssl rand -hex 32 生成）
SECRET_KEY=your-secret-key-here

# JWT 签名密钥（请与 SECRET_KEY 使用不同的随机值）
# 安全要求：必须为随机长字符串（openssl rand -hex 32）；当前 .env 中为历史明文密钥，
# 上线前必须在各平台（后端环境变量/运维配置）完成轮换重置，轮换后所有已签发令牌自动失效
JWT_SECRET_KEY=your-jwt-secret-key-here

# 数据库连接串（MySQL 示例：mysql+pymysql://用户名:密码@主机:3306/库名?charset=utf8mb4）
DATABASE_URL=your-database-url

# MinIO 对象存储（图片存放）
MINIO_ENDPOINT=your-minio-endpoint
MINIO_ACCESS_KEY=your-minio-access-key
MINIO_SECRET_KEY=your-minio-secret-key
MINIO_BUCKET_NAME=your-minio-bucket-name

# SMTP 邮件服务（发送邮箱验证码）
SMTP_SERVER=your-smtp-server
SMTP_PORT=465
EMAIL_ADDRESS=your-email-address
EMAIL_PASSWORD=your-email-password

# 腾讯云内容安全（头像/图片审核接口凭证）
TENCENT_CLOUD_API_KEY=your-tencent-cloud-api-key
TENCENT_CLOUD_API_SECRET=your-tencent-cloud-api-secret

# Redis（验证码存储与接口限流）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=your-redis-password

# 仅当部署在可信反向代理（nginx 等）之后设为 1，此时 X-Forwarded-For 才用于限流取真实 IP
TRUST_PROXY_HEADERS=0

# CORS 白名单（app/__init__.py:28 读取，同时作用于 HTTP 与 Socket.IO）
# 生产环境必须填实际前端来源，多个用英文逗号分隔，例如：
#   CORS_ORIGINS=https://www.example.com,https://admin.example.com
# 禁止使用 *：允许任意来源跨域携带令牌会放大 CSRF/令牌泄露风险
# 留空或为 * 时回退为 '*'，仅限本地开发使用
CORS_ORIGINS=*
